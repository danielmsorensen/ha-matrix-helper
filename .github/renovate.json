{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "timezone": "Europe/Berlin",
  "customManagers": [],
  "packageRules": [
    {
      "description": "pytest-homeassistant pins Home Assistant, which should match the homeassistant minimum in hacs.json",
      "matchPackageNames": ["pytest-homeassistant"],
      "enabled": false
    },
    {
      "description": "The frontend package must match the version homeassistant requires",
      "matchPackageNames": ["home-assistant-frontend"],
      "enabled": false
    }
  ]
}
